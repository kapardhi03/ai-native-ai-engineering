.claude

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets — never commit real keys. .env.example (placeholders only) is allowed.
.env
.env.*
!.env.example

# Generated belief cache is run output, not source.
# Comment this out if the exact cache behind the reported numbers should ship.
week1/deliverables/when-to-escalate/data/belief_cache_DRY.json

# Dry-run output is never reportable and must not be committed.
week1/deliverables/when-to-escalate/results/run_DRY.*

.venv

# LaTeX build output. Regenerated by any compile, so it is never source.
*.pdf
*.aux
*.log

# macOS Finder metadata. Never source, and easy to sweep in with `git add -A`.
.DS_Store

figures/*