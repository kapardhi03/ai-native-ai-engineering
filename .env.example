# Copy to .env and replace the placeholder values. .env is gitignored; this file
# is not, so it must never contain a real key.

# ─── Belief source ────────────────────────────────────────────────────────────
# At least one real key is required: the default refuses to run without one,
# so an unconfigured run cannot quietly produce keyword-scored beliefs.
OPENAI_API_KEY=sk-proj-REPLACE_ME
GOOGLE_API_KEY=AIza-REPLACE_ME

# ─── Provider policy ──────────────────────────────────────────────────────────
# auto   try openai, then google
# openai / google   pin one
# rule   keyword scoring only (requires BELIEF_ALLOW_RULE_FALLBACK=true)
BELIEF_PROVIDER=auto

# false (default): if every real provider fails, stop rather than fall back to
# keyword scoring. Keep it false for any run whose numbers you intend to report —
# a cache mixing LLM and keyword beliefs cannot support a calibration claim.
# Set true only for offline development.
BELIEF_ALLOW_RULE_FALLBACK=false

# ─── Models ───────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-2.0-flash

# ─── Cache ────────────────────────────────────────────────────────────────────
# Relative paths resolve against the repo root, never the working directory, so
# the same value means the same file wherever you run from.
BELIEF_CACHE_PATH=week1/when-to-escalate/data/belief_cache.json
